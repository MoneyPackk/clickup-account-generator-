# Application Configuration
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGGING=false

# Database Configuration
DATABASE_URL=postgresql://clickup_user:clickup_pass@localhost:5432/clickup_generator
DATABASE_POOL_SIZE=10
DATABASE_POOL_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ClickUp Configuration
CLICKUP_BASE_URL=https://app.clickup.com
CLICKUP_SIGNUP_PATH=/signup
CLICKUP_DASHBOARD_PATH=/dashboard
CLICKUP_TIMEOUT=30
CLICKUP_RETRIES=3
CLICKUP_RETRY_BACKOFF=2.0
CLICKUP_HEADLESS=true

# Security Configuration
PASSWORD_MIN_LENGTH=16
PASSWORD_MAX_LENGTH=64
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_SPECIAL_CHARS=!@#$%^&*()_+-=[]{}|;:,.<>?

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
BURST_LIMIT=10

# Secrets Management
SECRETS_BACKEND=environment
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_PATH=secret/clickup-generator
AWS_REGION=us-east-1
AWS_SECRET_NAME=clickup-generator

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=8000
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Chrome Configuration
CHROME_BINARY=
CHROME_DRIVER_PATH=
CHROME_DISABLE_GPU=true
CHROME_NO_SANDBOX=true
CHROME_DISABLE_DEV_SHM=true

# SMTP Configuration (for verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
